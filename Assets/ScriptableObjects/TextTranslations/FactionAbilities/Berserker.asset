  m_Script: {fileID: 11500000, guid: c35db23f7e82aa74cbe5900fcd6fc27a, type: 3}
  m_Name: Berserker
  m_EditorClassIdentifier: 
  _ruText: "\xAB\u0411\u0435\u0440\u0441\u0435\u0440\u043A\xBB. \u041F\u0440\u0438
    \u043F\u0430\u0434\u0435\u043D\u0438\u0438 \u0443\u0440\u043E\u0432\u043D\u044F
    \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F \u043D\u0438\u0436\u0435 50%
    \u0443 \u044E\u043D\u0438\u0442\u043E\u0432 \u0444\u0440\u0430\u043A\u0446\u0438\u0438
    \u0430\u0440\u0431\u0443\u0437\u043E\u0432 \u0443\u0440\u043E\u043D \u043F\u043E\u0432\u044B\u0448\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430 25%."
  _enText: '"The Berserker." When the health level drops below 50%, Watermelon faction
    units have damage increased by 25%.'
  _trText: "\"\xC7\u0131lg\u0131n\". Sa\u011Fl\u0131k seviyesi %50'nin alt\u0131na
    d\xFC\u015Ft\xFC\u011F\xFCnde karpuz fraksiyonunun birimlerinde hasar %25 artar."
