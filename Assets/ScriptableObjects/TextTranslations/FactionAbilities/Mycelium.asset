  m_Script: {fileID: 11500000, guid: c35db23f7e82aa74cbe5900fcd6fc27a, type: 3}
  m_Name: Mycelium
  m_EditorClassIdentifier: 
  _ruText: "\xAB\u0413\u0440\u0438\u0431\u043D\u0438\u0446\u0430\xBB. \u0413\u0440\u0438\u0431\u043D\u0430\u044F
    \u0441\u0432\u044F\u0437\u044C. \u0427\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435
    \u0443 \u0433\u0440\u0438\u0431\u043E\u0432 \u044E\u043D\u0438\u0442\u043E\u0432,
    \u0442\u0435\u043C \u043E\u043D\u0438 \u0441\u0438\u043B\u044C\u043D\u0435\u0435.
    +4% \u043A \u0430\u0442\u0430\u043A\u0435 \u0437\u0430 \u043A\u0430\u0436\u0434\u044B\u0439
    \u044E\u043D\u0438\u0442 \u0433\u0440\u0438\u0431\u0430 \u0432 \u0438\u0433\u0440\u0435."
  _enText: '"Mycelium". Mushroom connection. The more units the mushrooms have, the
    stronger they are. +4% attack bonus for each mushroom unit in the game.'
  _trText: "\"Miselyum\". Mantar ba\u011Flant\u0131s\u0131. Mantarlar\u0131n birimleri
    ne kadar fazlaysa, o kadar g\xFC\xE7l\xFCd\xFCrler. Oyundaki her mantar birimi
    i\xE7in sald\u0131r\u0131ya +% 4."
