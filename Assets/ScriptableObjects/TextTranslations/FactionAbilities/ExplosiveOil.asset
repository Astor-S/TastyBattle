  m_Script: {fileID: 11500000, guid: c35db23f7e82aa74cbe5900fcd6fc27a, type: 3}
  m_Name: ExplosiveOil
  m_EditorClassIdentifier: 
  _ruText: "\xAB\u0412\u0437\u0440\u044B\u0432\u043D\u043E\u0435 \u043C\u0430\u0441\u043B\u043E\xBB.
    \u041A\u043E\u0433\u0434\u0430 \u044E\u043D\u0438\u0442 \u0430\u0432\u043E\u043A\u0430\u0434\u043E
    \u043F\u043E\u0433\u0438\u0431\u0430\u0435\u0442, \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442
    \u0432\u0437\u0440\u044B\u0432, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043D\u0430\u043D\u043E\u0441\u0438\u0442
    \u0443\u0440\u043E\u043D \u0432\u0440\u0430\u0433\u0430\u043C \u0432 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u043E\u0439
    \u043E\u0431\u043B\u0430\u0441\u0442\u0438."
  _enText: '"Explosive oil." When an avocado unit is killed, an explosion occurs
    that damages enemies in a certain area.'
  _trText: "\"Patlay\u0131c\u0131 ya\u011F\". Avokado birimi \xF6ld\xFC\u011F\xFCnde,
    baz\u0131 b\xF6lgelerdeki d\xFC\u015Fmanlara zarar veren bir patlama meydana
    gelir."
