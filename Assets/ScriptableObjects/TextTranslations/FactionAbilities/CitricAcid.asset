  m_Script: {fileID: 11500000, guid: c35db23f7e82aa74cbe5900fcd6fc27a, type: 3}
  m_Name: CitricAcid
  m_EditorClassIdentifier: 
  _ruText: "\xAB\u0426\u0438\u0442\u0440\u0443\u0441\u043E\u0432\u0430\u044F \u043A\u0438\u0441\u043B\u043E\u0442\u0430\xBB.
    \u0410\u0442\u0430\u043A\u0438 \u0430\u043F\u0435\u043B\u044C\u0441\u0438\u043D\u043E\u0432
    \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u044E\u0442 \u044D\u0444\u0444\u0435\u043A\u0442
    \u043A\u0438\u0441\u043B\u043E\u0442\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u043E\u0442\u043D\u0438\u043C\u0430\u0435\u0442 \u043F\u043E 1 \u0445\u043F
    \u0432 \u0441\u0435\u043A\u0443\u043D\u0434\u0443 \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435
    3 \u0441\u0435\u043A\u0443\u043D\u0434."
  _enText: '"Citric acid". Orange attacks have an acid effect that takes 1 hp per
    second for 3 seconds.00'
  _trText: "\"Narenciye asidi\". Portakallar\u0131n sald\u0131r\u0131lar\u0131, 3
    saniye boyunca saniyede 1 hp alan bir asit etkisi yarat\u0131r."
