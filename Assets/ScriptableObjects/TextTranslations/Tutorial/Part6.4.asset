  _ruText: "\u041F\u043E\u0441\u043B\u0435 \u0430\u043A\u0442\u0438\u0432\u0430\u0446\u0438\u0438
    \u043F\u043E\u0434\u043C\u043E\u0433\u0438 \u0432\u0430\u0448\u0430 \u0431\u0430\u0437\u0430
    \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u043D\u0435\u0443\u044F\u0437\u0432\u0438\u043C\u043E\u0439
