  m_Script: {fileID: 11500000, guid: 8fd51b6ba2d0c4649a254d792db5c2a0, type: 3}
  m_Name: Part6.1
  m_EditorClassIdentifier: 
  _textFields:
  - "\u041A\u043E\u0433\u0434\u0430 \u0441\u0438\u043B\u044B \u043D\u0430 \u0438\u0441\u0445\u043E\u0434\u0435,
    \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0432\u043E\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
    \u043A\u043D\u043E\u043F\u043A\u043E\u0439 \u043F\u043E\u0434\u043C\u043E\u0433\u0438."
  - "\u041E\u043D\u0430 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
    \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0439 \u043A\u043E\u0433\u0434\u0430
    \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435 \u0432\u0430\u0448\u0435\u0439
    \u0431\u0430\u0437\u044B \u043F\u0430\u0434\u0430\u0435\u0442 \u043D\u0438\u0436\u0435
    \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u044B!"
  - "\u041F\u043E\u0441\u043B\u0435 \u0430\u043A\u0442\u0438\u0432\u0430\u0446\u0438\u0438
    \u043F\u043E\u0434\u043C\u043E\u0433\u0438 \u0432\u0430\u0448\u0430 \u0431\u0430\u0437\u0430
    \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u043D\u0435\u0443\u044F\u0437\u0432\u0438\u043C\u043E\u0439
    \u043D\u0430 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0432\u0440\u0435\u043C\u044F!"
  - "\u0421\u043F\u044F\u0442\u0441\u044F \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u043E\u0435
    \u0432\u0440\u0435\u043C\u044F \u043F\u043E\u0441\u043F\u0435\u0432\u0430\u0435\u0442
    \u043F\u043E\u0434\u043C\u043E\u0433\u0430."
  - "\u0423\u0447\u0442\u0438\u0442\u0435, \u0447\u0442\u043E \u043F\u043E\u0434\u043C\u043E\u0433\u0430
    \u0441\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0435\u0442 \u043B\u0438\u0448\u044C
    \u0435\u0434\u0438\u043D\u043E\u0436\u0434\u044B \u0437\u0430 \u0431\u043E\u0439!"
