  _textFields:
  - "\u0427\u0442\u043E\u0431\u044B \u043F\u0440\u0438\u0437\u0432\u0430\u0442\u044C
    \u0432\u043E\u0438\u043D\u043E\u0432, \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435
    \u043A\u043B\u0438\u043A\u043D\u0443\u0442\u044C \u043D\u0430 \u0438\u043A\u043E\u043D\u043A\u0438,
    \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0435
    \u0440\u043E\u043B\u0438 \u0432\u043E\u0438\u043D\u043E\u0432."
  - "\u041A\u0430\u0436\u0434\u044B\u0439 \u0432\u043E\u0438\u043D \u043F\u043E \u0441\u0432\u043E\u0435\u043C\u0443
    \u0443\u043D\u0438\u043A\u0430\u043B\u0435\u043D \u0438 \u0438\u043C\u0435\u0435\u0442
    \u0441\u0432\u043E\u044E \u0446\u0435\u043D\u0443. \u0422\u0440\u0430\u0442\u044C\u0442\u0435
    \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u044B \u0441 \u0443\u043C\u043E\u043C!"
